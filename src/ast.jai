// This file declares the Abstract Syntax Tree (AST) and nodes which are generated by the parser.

#scope_export

Node_Kind :: enum u32 {

    /*
        Operators are rolled-up/categorized into either a unary or binary operator node.
        This reduces the overall number of AST node types but introduces additional computational
        overhead. Once a binary operator node is reached in the AST dispatching is required on
        the operator type whereas a separate 'Addition' node for example would not need this check.
    */

    Error;
    Identifier;
    Variable;
    Element;              // element of an exterior space
    Unary_Operator;       // prefix/postfix operators
    Binary_Operator;      // all infix operators during parsing
    Associative_Operator; // all associative binary operators after flattening the AST
    Intrinsic;
}

Ast_Node :: struct {
    kind: Node_Kind;
    node_id: u16;       // indexes position metadata list stored on AST for error reporting for the node.
}

Ast :: struct {
    root: *Ast_Node;
    position_metadata: [] Position_Info;
}

Error_Node :: struct {
    #as using _kind: Ast_Node;
    message: string;
}

Identifier_Node :: struct {
    #as using _kind: Ast_Node;
    name: string;
}

Variable_Node :: struct {
    // Identifier nodes are converted to this node type during symbol resolution.
    #as using _kind: Ast_Node;
    name: string;
}

Element_Node :: struct {
    #as using _kind: Ast_Node;

	coefficient:  Coefficient;
	basis:       *Basis_Element;
}

Unary_Operator_Node :: struct {
    #as using _kind: Ast_Node;
    op:  Operator_Type;
    rhs: *Ast_Node;
}

Binary_Operator_Node :: struct {
    #as using _kind: Ast_Node;
    lhs: *Ast_Node;
    op:  Operator_Type;
    rhs: *Ast_Node;
}

Associative_Operator_Node :: struct {
    #as using _kind: Ast_Node;
    op: Operator_Type;
    args: [] *Ast_Node;
}


// Keywords get mapped to intrinsic node types.
// Intrsics are predefined functions/commands that user's can call within an expression.
Intrinsic_Type :: enum u8 {
    Direction;
    Position;
    Basis;
}

Intrinsic_Node :: struct {
    #as using _kind: Ast_Node;
    type: Intrinsic_Type;
}

ast_contains_error :: (ast: Ast) -> bool {
    return ast.root.kind == .Error;
}

ast_print_error :: (ast: Ast) {
    error := cast(*Error_Node)ast.root;
    print("%\n", error.message);
}

ast_represents_assignment :: (ast: Ast) -> bool {
    assert(ast.root != null);
    binary_op := cast(*Binary_Operator_Node)ast.root;

    return ast.root.kind == .Binary_Operator && binary_op.op == .Assignment;
}

new_error_node :: (node_id: u16, message: string) -> *Error_Node {

    node: *Error_Node = alloc(size_of(Error_Node));
    assert(node != null);

    node.kind    = Node_Kind.Error;
    node.node_id = node_id;
    node.message = message;

    return node;
}

new_identifier_node :: (node_id: u16, name: string) -> *Identifier_Node {

    node: *Identifier_Node = alloc(size_of(Identifier_Node));
    assert(node != null);

    node.kind    = Node_Kind.Identifier;
    node.node_id = node_id;
    node.name    = name;
    return node;
}

new_variable_node :: (node_id: u16, name: string) -> *Variable_Node {

    node: *Variable_Node = alloc(size_of(Variable_Node));
    assert(node != null);

    node.kind    = Node_Kind.Variable;
    node.node_id = node_id;
    node.name    = name;
    return node;
}

new_element_node :: (node_id: u16, coefficient: Coefficient, basis_element: *Basis_Element) -> *Element_Node {

    node: *Element_Node = alloc(size_of(Element_Node));
    assert(node != null);

    node.kind        = Node_Kind.Element;
    node.node_id     = node_id;
    node.coefficient = coefficient;
    node.basis       = basis_element;

    return node;
}

new_unary_operator_node :: (node_id: u16, op: Operator_Type, rhs: *Ast_Node) -> *Unary_Operator_Node {

    node: *Unary_Operator_Node = alloc(size_of(Unary_Operator_Node));
    assert(node != null);

    node.kind    = Node_Kind.Unary_Operator;
    node.node_id = node_id;
    node.op      = op;
    node.rhs     = rhs;

    return node;
}

new_binary_operator_node :: (node_id: u16, lhs: *Ast_Node, op: Operator_Type, rhs: *Ast_Node) -> *Binary_Operator_Node {

    node: *Binary_Operator_Node = alloc(size_of(Binary_Operator_Node));
    assert(node != null);

    node.kind    = Node_Kind.Binary_Operator;
    node.node_id = node_id;
    node.lhs     = lhs;
    node.op      = op;
    node.rhs     = rhs;

    return node;
}

new_associative_operator_node :: (node_id: u16, op: Operator_Type, args: [] *Ast_Node) -> *Associative_Operator_Node {

    node: *Associative_Operator_Node = alloc(size_of(Associative_Operator_Node));
    assert(node != null);

    node.kind    = Node_Kind.Associative_Operator;
    node.node_id = node_id;
    node.op      = op;
    node.args    = args;

    return node; 
}

new_intrinsic_node :: (node_id: u16, type: Intrinsic_Type) -> *Intrinsic_Node {

    node: *Intrinsic_Node = alloc(size_of(Intrinsic_Node));
    assert(node != null);

    node.kind    = Node_Kind.Intrinsic;
    node.node_id = node_id;
    node.type    = type;

    return node;
}

