copy_node :: (node: *Ast_Node) -> *Ast_Node {

	dst: *Ast_Node = null;
	if node.kind == .Element {
		src         := cast(*Element_Node)node;
        coefficient := src.coefficient;         // shallow copy!
        basis       := src.basis;

		dst = new_element_node(src.node_id, coefficient, basis);
	}
    else
    if node.kind == .Variable {
        src := cast(*Variable_Node)node;
        dst  = new_variable_node(src.node_id, src.name);
    }
	else
	if node.kind == .Unary_Operator {
		src := cast(*Unary_Operator_Node)node;
        rhs := copy_node(src.rhs);

		dst  = new_unary_operator_node(src.node_id, src.op, rhs);
	}
	else
	if node.kind == .Binary_Operator {
		src := cast(*Binary_Operator_Node)node;
		lhs := copy_node(src.lhs);
        rhs := copy_node(src.rhs);

		dst = new_binary_operator_node(src.node_id, lhs, src.op, rhs);
	}
	else {
		print( "Unrecognized node kind found when cloning nodes\n" );
	}

	return dst;
}

ast_to_string :: (ast: Ast) -> string {

    ast_to_string_helper :: (node: *Ast_Node, builder: *String_Builder) {

        if node.kind == .Element {
            element := cast(*Element_Node)node;
            coefficient  := coefficient_to_string(element.coefficient);
            basis_symbol := element.basis.symbol;

            append(builder, "(" );
            append(builder, coefficient);
            append(builder, ")" );
            append(builder, basis_symbol);
        }
        else
        if node.kind == .Binary_Operator {
            binary_op := cast(*Binary_Operator_Node)node;
            ast_to_string_helper(binary_op.lhs, builder);
            append(builder, " + ");
            ast_to_string_helper(binary_op.rhs, builder);
        }
    }

    builder: String_Builder;
    ast_to_string_helper(ast.root, *builder);

    return builder_to_string(*builder);
}

descend :: (ast: Ast) {

    // Utility function to print AST's until the interpreter is up and working!
    descend_helper :: (node: *Ast_Node, indent: int = 0) {
        if node == null {
            return;
        }

        for i: 0..indent-1 {
            print( " " );
        }

        if node.kind == .Error {
            error := cast(*Error_Node)node;
            print("(%) Error Node == %\n", error.node_id, error.message);
        }
        else
        if node.kind == .Unary_Operator {
            operator_node := cast(*Unary_Operator_Node)node;
            print("(%) Unary operator == %\n", operator_node.node_id, operator_node.op);
            descend_helper(operator_node.rhs, indent + 2);
        }
        else
        if node.kind == .Identifier {
            identifier := cast(*Identifier_Node)node;
            print("(%) Identifier == %\n", identifier.node_id, identifier.name);
        }
        else
        if node.kind == .Variable {
            var := cast(*Variable_Node)node;
            print("(%) Variable == %\n", var.node_id, var.name);
        }
        else
        if node.kind == .Element {
            element := cast(*Element_Node)node;
            print(
                "(%) Element (Coefficient=%, Grade=%, Symbol=%, Bits=%)\n"
                ,element.node_id
                ,coefficient_to_string(element.coefficient)
                ,element.basis.grade
                ,element.basis.symbol
                ,element.basis.bitset
            );
        }
        else
        if node.kind == .Binary_Operator {
            binary_operator := cast(*Binary_Operator_Node)node;
            print("(%) Binary Operator == %\n", binary_operator.node_id, binary_operator.op );
            descend_helper(binary_operator.lhs, indent + 2);
            descend_helper(binary_operator.rhs, indent + 2);
        }
        else
        if node.kind == .Intrinsic {
            intrinsic := cast(*Intrinsic_Node)node;
            if intrinsic.type == {
                case .Direction; { print("(%) Intrinsic: Direction\n", intrinsic.node_id); }
                case .Position;  { print("(%) Intrinsic: Position\n",  intrinsic.node_id); }
                case .Basis;     { print("(%) Intrinsic: Basis\n",     intrinsic.node_id); }
            }
        }
        else
        if node.kind == .Associative_Operator {
            associative_op := cast(*Associative_Operator_Node)node;
            print("(%) Associative Operator == %\n", associative_op.node_id, associative_op.op);
            for i: 0..associative_op.args.count-1 {
                descend_helper(associative_op.args[i], indent + 2);
            }
        }
    }

    descend_helper(ast.root, indent = 0);
    return;
}